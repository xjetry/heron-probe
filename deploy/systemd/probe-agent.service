[Unit]
Description=probe monitoring agent
# 采集只读 /proc、/sys 与配置；加固项若遮蔽了采集路径不会以启动失败显形，
# 由真机验收的"服务与 root 手动运行指标对照"承载（spec §12、§14）。
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# install.sh 停服务后按"有效 uid 等于 probe-agent"确认进程都已退出，前提是本服务的每个进程都以它运行；
# 新增以其他身份运行的 Exec*（如 ExecStartPre=+）或改用 DynamicUser= 时必须同步改那里的判据。
User=probe-agent
Group=probe-agent
ExecStart=/usr/local/bin/probe-agent run --config /etc/probe-agent/config.json
Restart=on-failure
# 裸机 Debian/Ubuntu/Alpine 的 ping_group_range 默认关闭，没有 CAP_NET_RAW 时
# ICMP 探测只能回报 error；Rocky 9 放开是发行版默认值，不作依赖（§13 第 2 项）。
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# 用户由安装脚本创建并拥有配置文件（0600），OpenRC 侧以同一用户运行：这里用静态 User=，
# 需要的加固逐项写出，不经 DynamicUser= 隐式引入。RestrictSUIDSGID= 是 DynamicUser= 会隐含的一项，在此明写（spec §14）。
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
